# Google Cloud Project ID
PROJECT_ID=your-project-id

# Google Cloud Region for GKE clusters
GCP_REGION=us-central1

# Google Cloud Artifact Registry repository name
GCP_REPOSITORY=daystar-repo

# Set to true to use MockProber (simulates operations by creating files).
# Set to false to use GkeProber (calls real GKE APIs).
USE_MOCK=true
